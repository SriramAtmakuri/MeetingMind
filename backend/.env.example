# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored.
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Database — choose one:
# PostgreSQL (recommended for production, use with docker-compose):
#   DATABASE_URL=postgres://meetingmind:meetingmind_dev@localhost:5432/meetingmind
# SQLite (zero-config local dev, used when DATABASE_URL is not set):
DATABASE_PATH=./data/meetingmind.db

# Redis (required for BullMQ job queue)
# Local:   redis://localhost:6379
# Render:  set REDIS_URL in the Render dashboard
REDIS_URL=redis://localhost:6379

# ---- AI / Gemini -----------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
# Keep this server-side only — never use in frontend code.
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Firebase Storage (optional) --------------------------------
# Only needed if using Firebase for audio file storage.
# Download the service account JSON from Firebase console →
# Project settings → Service accounts → Generate new private key.
# Store the file outside the repo or in a secrets manager.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ---- File Storage -----------------------------------------------
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage
MAX_FILE_SIZE=524288000

# ---- Processing -------------------------------------------------
MAX_CONCURRENT_JOBS=2
TRANSCRIPTION_WORKER_COUNT=1

# ---- CORS -------------------------------------------------------
# Set to your frontend origin in production
FRONTEND_URL=http://localhost:5173

# ---- Error tracking (optional) ----------------------------------
# Get DSN from sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values.
# IMPORTANT: Any VITE_ variable is bundled into the browser
# JS bundle and is visible to all users. Never put API keys,
# secrets, or credentials here.
# ============================================================

# URL of the backend API server
VITE_API_URL=http://localhost:3001/api

# Application metadata (safe — no secrets)
VITE_APP_NAME=MeetingMind
VITE_APP_VERSION=1.0.0

# ============================================================
# Firebase Auth (optional — app works without it using local mock)
# Get these from Firebase Console → Project Settings → Your apps
# These are PUBLIC client-side identifiers — safe to commit.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Sentry error tracking (optional)
# Get DSN from sentry.io → Project Settings → Client Keys
# ============================================================
VITE_SENTRY_DSN=

# ============================================================
# Backend API keys (GEMINI_API_KEY etc.) belong in
# backend/.env — NOT here. See backend/.env.example.
# ============================================================
